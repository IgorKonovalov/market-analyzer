# market-analyser — example local environment overrides.
#
# Copy to `.env` and fill in your own values. `.env` is gitignored; this
# `.env.example` is the only env file committed to the repo — never put a real
# key here.
#
# These are third-party data-source API keys. Per ADR-0038 the canonical store
# is a 0600 `secrets.json` in the user-data dir; each known key ALSO has a
# `MARKET_ANALYSER_<KEY>` environment-variable override, read dynamically and
# taking precedence over the file (handy for dev/CI).
#
# In a dev / source checkout the sidecar auto-loads a repo-root `.env` at
# startup, so copying this file to `.env` and filling in a value is enough.
# A real environment variable wins over `.env` (override=False), and packaged
# builds load nothing (no `.env` ships next to the bundled source) — there, use
# `POST /settings/secret` (persists to secrets.json). See the README "Secrets".

# Zerion REST API key — REQUIRED for DeFi wallet discovery (the `scan_wallet`
# MCP tool / `POST /defi/scan`). Without it the scan returns a typed
# "no API key configured" error. Free Developer tier: https://zerion.io/api
MARKET_ANALYSER_ZERION_API_KEY=zk_your_key_here

# --- later DeFi plans (declared in the secrets schema, not yet consumed) ---
# The Graph API key (decentralized network) for deep on-chain subgraph reads.
#MARKET_ANALYSER_GRAPH_API_KEY=
# EVM RPC endpoints for deep on-chain state (Aave health factor, Uni-v3 ticks/fees).
#MARKET_ANALYSER_ETH_RPC_URL=
#MARKET_ANALYSER_BASE_RPC_URL=
