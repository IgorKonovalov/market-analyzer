{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist/main",
    "types": ["node"]
  },
  "include": ["electron/**/*", "shared/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "electron/preload/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
