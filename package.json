{
  "name": "market-analyser-workspace",
  "private": true,
  "version": "0.0.1",
  "description": "pnpm workspace root for market-analyser (Python sidecar + desktop shell).",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "dev:all": "node scripts/dev/dev-all.mjs",
    "smoke": "uv run python tests/smoke/golden_path.py",
    "build": "pnpm --filter desktop build",
    "test": "pnpm --filter desktop test:all",
    "test:dev-scripts": "node --test scripts/dev/__tests__/write-mcp-config.test.mjs scripts/dev/__tests__/spawn-sidecar.test.mjs",
    "typecheck": "pnpm --filter desktop typecheck",
    "gen:api-docs": "uv run python -m market_analyser.apiref",
    "gen:api-docs:check": "uv run python -m market_analyser.apiref --check",
    "specs:check": "uv run python -m market_analyser.specs --check"
  },
  "devDependencies": {
    "concurrently": "9.0.1",
    "husky": "9.1.6",
    "wait-on": "8.0.1"
  }
}
