{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["renderer/**/*", "shared/**/*", "renderer/types/global.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "tests/**/*",
    "electron/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
