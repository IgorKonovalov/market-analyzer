# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
# uv.lock is committed; uv's caches are not.

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code: commit the project skills, ignore per-machine settings.
# skill-creator is intentionally excluded (general-purpose meta tooling).
.claude/*
!.claude/skills/
.claude/skills/skill-creator/
skills-lock.json

# Local secrets / app data
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
# MCP bearer secret — lives in the user data dir at runtime (ADR-0014); never commit.
mcp-secret*.json
# Sidecar lockfile — written by the standalone sidecar at boot, removed on
# clean shutdown (ADR-0016, Plan 0007). Carries the per-launch renderer bearer;
# must never land in the repo. `.tmp` covers the atomic-write tempfile.
sidecar.lock
sidecar.lock.tmp
# Claude Code MCP config — local-only because it carries the MCP bearer inline.
# Auto-written by `pnpm dev:all` (Plan 0015) from the live sidecar.lock + the
# long-lived mcp-secret.json. See docs/onboarding/claude-code-setup.md for the
# full workflow; this file is the user's working copy on their own machine.
.mcp.json

# DeFi positions (sensitive — local only, never committed)
# Holds the user's wallet → pool/position mapping consumed by the defi-analyst skill.
# The template is at .claude/skills/defi-analyst/assets/positions.example.yaml.
positions/

# Run artifacts — backtest, analysis, and DeFi outputs are all local-only
# (CLAUDE.md "Where things live": runs/ is gitignored). DeFi runs additionally
# may reference wallet addresses or position ids, so this must never relax to a
# per-subdir allowlist.
runs/

# Trained forecast model artifacts (Plan 0036 / ADR-0040): versioned, gitignored,
# sibling to runs/. They are data, not credentials, but are regenerable from the
# cached bars + seed, so they are never versioned.
models/

# Desktop (Electron) — will be populated in phase 4
desktop/node_modules/
desktop/dist/
desktop/release/
desktop/.vite/
desktop/test-results/
node_modules
